{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SafeCore",
    "Audience": "SafeCore.Clients",
    "AccessTokenMinutes": 15
  },
  "SafetyThresholds": {
    "TemperatureCelsius": 40.0,
    "GasAdcRiseCounts": 100.0,
    "AccelerationMagnitudeDeltaCounts": 200.0,
    "ImpactAlertMilliseconds": 1500
  }
}
